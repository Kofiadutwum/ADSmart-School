# Copy to .env.local. Server-side only unless prefixed NEXT_PUBLIC_.
DJANGO_ORIGIN=http://127.0.0.1:8000
# The platform's main domain: localhost in development, so schools are <slug>.localhost:3000
PLATFORM_DOMAIN=localhost
# Same value as REVALIDATE_SECRET in backend/.env: lets Django refresh the platform website.
REVALIDATE_SECRET=
# Going live (Plan 6A; docs/deploy/vercel.md). Leave blank in development.
# The same long random value as PROXY_SECRET in backend/.env.
PROXY_SECRET=
# The admin area's address until the platform has its own domain, e.g. adsmartschool-admin.vercel.app
ADMIN_HOST=
# Where uploaded photos are served from, e.g. https://res.cloudinary.com/<cloud name>/
NEXT_PUBLIC_MEDIA_ORIGIN=
