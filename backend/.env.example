# Copy to backend/.env and adjust. Never commit the real .env.
DJANGO_SECRET_KEY=replace-with-the-output-of-py-c-import-secrets-print-secrets.token_urlsafe-50
DJANGO_DEBUG=true
# Leave DJANGO_ALLOWED_HOSTS unset: Django is reachable only through Next.js, which forwards
# each visitor's address, and Django matches it to a school (or answers 404).
PLATFORM_NAME=ADsmartschool
PLATFORM_DOMAIN=localhost
PLATFORM_EMAIL=kofiadutwumjnr881@gmail.com
PLATFORM_PHONE=+233545875881
SITE_URL_TEMPLATE=http://{host}:3000
# Django asks Next.js to refresh the platform website after content changes. Use the same long
# random value as REVALIDATE_SECRET in frontend/.env.local; leave empty to rely on the
# 5-minute refresh alone.
FRONTEND_ORIGIN=http://127.0.0.1:3000
REVALIDATE_SECRET=
# Development PostgreSQL from tools/postgres (cd tools/postgres && npm install && npm start).
# Production: the real server's URL. Unset falls back to SQLite (used only by the browser tests).
DATABASE_URL=postgres://adss:adss-dev-only@127.0.0.1:5433/adss
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=ADsmartschool <no-reply@localhost>
# Keep at 1: only Caddy adds X-Forwarded-For (Next.js passes it through unchanged).
DJANGO_NUM_PROXIES=1
# SMS: the console backend prints codes in the Django log. A provider backend comes before launch.
SMS_BACKEND=apps.notifications.backends.ConsoleBackend
# Development only: seed_demo also makes one demo sign-in per role and prints the password.
# DEMO_LOGINS_ENABLED=true

# Going live (Plan 6A; docs/deploy/vercel.md). Leave blank in development.
# The same long random value as PROXY_SECRET in the website's settings.
PROXY_SECRET=
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# The admin area's address until the platform has its own domain, e.g. adsmartschool-admin.vercel.app
ADMIN_HOST=
# Uploaded photos on Cloudinary (cloudinary://key:secret@cloud-name). Blank: backend/media.
CLOUDINARY_URL=
# Largest photo upload. Vercel accepts request bodies up to 4.5 MB, so use 4 there.
PHOTO_MAX_MB=10
# Sending email (sign-in codes): any SMTP server, e.g. Gmail with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
